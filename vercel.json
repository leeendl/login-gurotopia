{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "index.ts": {
      "runtime": "nodejs20.x",
      "includeFiles": "template/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.ts"
    }
  ]
}
